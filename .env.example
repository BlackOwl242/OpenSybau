# Local access is the default. For mobile access on your LAN, use the production build:
# WORKBENCH_HOST=0.0.0.0
# WORKBENCH_PORT=4173
# WORKBENCH_ALLOWED_HOSTS=192.168.1.20:4173
# WORKBENCH_ACCESS_USERNAME=opensybau
# Use a unique password with at least 16 characters. Do not commit your real .env file.
# WORKBENCH_ACCESS_PASSWORD=replace-with-a-long-random-password

# Optional: move task history, memory, and worktrees outside the app folder.
# WORKBENCH_DATA_DIR=D:/OpenSybauData

# Optional: provide a certificate and private key for direct HTTPS.
# WORKBENCH_TLS_CERT=D:/OpenSybau/certs/fullchain.pem
# WORKBENCH_TLS_KEY=D:/OpenSybau/certs/private-key.pem

# Optional executable overrides when CLIs are not on PATH; Claude Code also accepts its cli.js entry point.
# CODEX_CLI_PATH=C:/Users/you/.local/bin/codex.exe
# ANTIGRAVITY_CLI_PATH=C:/Users/you/AppData/Local/agy/bin/agy.exe
# CLAUDE_CLI_PATH=C:/Users/you/AppData/Roaming/npm/node_modules/@anthropic-ai/claude-code/cli.js

# Optional Claude API provider. Use a model ID supported by your Anthropic account.
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# WORKBENCH_CLAUDE_MODEL=your-claude-model-id
# WORKBENCH_CLAUDE_MODELS=your-claude-model-id,another-supported-model-id
# WORKBENCH_CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Optional external API providers (up to 12). Supported protocols: anthropic, openai-compatible.
# API providers can chat, plan, review, or return bounded text-file edits; they cannot run workspace tools.
# Put each secret in its own environment variable and reference its name below; never place a key in this JSON.
# EXAMPLE_API_KEY=replace-with-your-provider-api-key
# WORKBENCH_API_PROVIDERS='[{"id":"example-api","name":"Example API","protocol":"openai-compatible","baseUrl":"https://api.example.com/v1","apiKeyEnv":"EXAMPLE_API_KEY","models":["your-model-id"]}]'
