# Local access is the default. For mobile access on your LAN, use the production build:
# WORKBENCH_HOST=0.0.0.0
# WORKBENCH_PORT=4173
# WORKBENCH_ALLOWED_HOSTS=192.168.1.20:4173
# WORKBENCH_ACCESS_USERNAME=opensybau
# Use a unique password with at least 16 characters. Do not commit your real .env file.
# WORKBENCH_ACCESS_PASSWORD=replace-with-a-long-random-password

# Optional: move task history, memory, and worktrees outside the app folder.
# WORKBENCH_DATA_DIR=D:/OpenSybauData

# Optional: provide a certificate and private key for direct HTTPS.
# WORKBENCH_TLS_CERT=D:/OpenSybau/certs/fullchain.pem
# WORKBENCH_TLS_KEY=D:/OpenSybau/certs/private-key.pem

# Optional executable overrides when CLIs are not on PATH. Use executable binaries, not shell wrappers.
# CODEX_CLI_PATH=C:/Users/you/.local/bin/codex.exe
# ANTIGRAVITY_CLI_PATH=C:/Users/you/AppData/Local/agy/bin/agy.exe
