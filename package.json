{
  "name": "opensybau",
  "description": "A local-first multi-agent coding workspace for Windows and the browser.",
  "author": "OpenSybau",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackOwl242/OpenSybau.git"
  },
  "private": true,
  "version": "0.2.46",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "vite build",
    "test": "node scripts/test-cli-detection.mjs && node scripts/test-task-features.mjs",
    "start": "node scripts/run.mjs production",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis --publish never",
    "desktop:release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@preact/preset-vite": "^2.10.6",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.3.3"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "BlackOwl242",
      "repo": "OpenSybau",
      "releaseType": "release"
    },
    "appId": "com.opensybau.desktop",
    "productName": "OpenSybau",
    "asar": true,
    "files": [
      "desktop/**/*",
      "server.mjs",
      "src/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": "opensybau.env.example"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenSybau-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenSybau"
    }
  }
}
